# agent-command-chain-template 설정값
# 사용법: cp config.env.example config.env  후 값 수정
#
# [실행 경로 안내]
# - 기본 권장 경로: bootstrap-v2.sh / watchdog-v2.sh (Full-Push 이벤트 통지 브리지 v2)
# - 폴백/레거시 경로: bootstrap.sh / watchdog.sh (v1, 순수 tmux pull 기반)
#
# 대상 프로젝트 디렉토리. 기본은 "bootstrap(-v2).sh/watchdog(-v2).sh를 실행한 위치"다
# (설정 안 하면 비워두면 됨 — 이 줄 자체를 주석 처리 상태로 둘 것).
# 이 값을 채우면 어디서 스크립트를 부르든 항상 이 프로젝트로 고정된다.
# 여러 프로젝트에 이 템플릿을 재사용하려면: 프로젝트마다 이 템플릿을 클론해서
# 각자 config.env 를 따로 두거나, 항상 그 프로젝트 디렉토리에서 실행해라.
# PROJECT_DIR=/path/to/your/project

# tmux 세션 이름 (다른 프로젝트와 겹치지 않게 프로젝트별로 바꿀 것)
# ⚠ v2 Full-Push 세션 운용 시 세션명 불일치(예: agentchain vs agentchain-v2)로 인한
# 오조준을 방지하기 위해 dispatch.sh 실행 시 `SESSION_NAME=<세션명>` 명시를 권장합니다.
# 생략 시 4계층 자동 해석 우선순위(환경변수 -> 런타임마커 -> 현재tmux -> config기본값)를 따릅니다.
SESSION_NAME=agentchain

# tmux 윈도우 이름
SONNET_WINDOW=sonnet
AGY_WINDOW=agy
CODEX_WINDOW=codex

# Sonnet(계층1: 감독/디스패치) 실행 커맨드
# --remote-control 은 스크립트에서 바로 켜지는 옵션 (첫 실행 시 대화형 확인 없음).
# 단, claude.ai Pro/Max/Team/Enterprise 구독 + `claude /login` OAuth 로그인이
# 사전에 되어 있어야 한다. API 키 인증(ANTHROPIC_API_KEY)만 있으면 안 됨.
SONNET_CMD="claude --model sonnet --remote-control"

# agy(계층2: 라우터 겸 워커) 실행 커맨드 (v1 폴백 전용 대화형 기동).
# 출처: eraweb-fork CLI_START_HERE.md 의 공식 수동 진입 절차.
# 주의:
# - v2 Full-Push 환경(기본 권장)에서는 agy 창이 유휴 셸(bash)로 대기하다가
#   dispatch.sh 호출 시 adapters/agy-oneshot.sh를 통해 단발 oneshot(-p)으로 실행됩니다.
#   agy 단발 턴 내에서 서브에이전트 위임은 LLM 도구인 `invoke_subagent`를 호출합니다.
#   (--agent 플래그는 세션 메인 에이전트 지정용이며 서브에이전트 소환 수단이 아닙니다)
# - 아래 AGY_CMD 설정값은 v1 레거시 폴백 브리지(bootstrap.sh)의 대화형 상주 기동에만 사용됩니다.
# 참고: 같은 저장소 tools/router/src/adapters/agyAdapter.ts 의 one-shot 형태는
#   v2 어댑터(adapters/agy-oneshot.sh)에서 단발 실행으로 활용됩니다.
#
# ⚠ WSL에서 실행한다면: agy가 Linux 빌드 없이 Windows 전용 바이너리로만 배포된
# 경우가 있다(2026-09 기준 Antigravity CLI 실측). 그럴 땐 WSL tmux 창에서
# cmd.exe interop으로 우회해야 한다. cmd.exe는 UNC 경로(\\wsl.localhost\...)로
# cd를 못 하므로 실제 Windows 드라이브 경로(C:\...)를 명시해야 한다:
#   AGY_CMD='cmd.exe /c "cd /d C:\path\to\project && agy.exe --new-project --mode plan"'
# agy가 WSL 네이티브로 깔려 있다면 아래처럼 그냥 직접 실행하면 된다:
AGY_CMD="agy --new-project --mode plan"

# agy 상주 TUI(resident) 실행 커맨드 (Stage 1 상주 라우터 전용).
# 실측 결과 및 채택 근거 (Task F8 실측):
# - 기본 AGY_CMD의 `--mode plan`은 도구(파일 편집, 셸) 실행을 차단하고 계획(/plan)만 출력하여 상주 라우터에 부적합함.
# - `--dangerously-skip-permissions`를 적용하여 대화형 권한 확인 없이 invoke_subagent 위임 및 도구 실행이 즉각 수행되도록 함.
# - `--mode plan`을 제거하여 accept-edits 모드로 상주 구동함.
# - oneshot 경로 및 기존 AGY_CMD는 그대로 보존됨.
AGY_RESIDENT_CMD="agy --dangerously-skip-permissions"
# Codex (계층2 안의 설계+직접수행 워커) 실행 커맨드 — 대화형 기동 (v1 레거시/폴백 전용).
# ⚠ v2 Full-Push 환경(기본 권장)에서는 adapters/codex-oneshot.sh를 통해 단발 실행되므로 이 값은 사용되지 않습니다.
# 대화형 TUI 기동 시 모델은 동적 해석($(bin/resolve-model.sh sol))을 적용하거나 비상 시 직접 명시합니다.
# 주의: config.env 로드 시점의 디렉터리 종속성을 피하기 위해 \$ 치환 또는 bin/resolve-model.sh 호출을 사용합니다.
CODEX_CMD="codex --model \$(bin/resolve-model.sh sol) -s danger-full-access"

# 처음 보는 프로젝트 디렉토리에서 claude/codex가 띄우는 "이 폴더를 신뢰하는가"
# 대화형 확인을 bootstrap.sh가 자동으로 눌러줄지 여부. --dangerously-skip-*
# 류 플래그로는 이 대화형 확인 자체를 못 건너뛴다(실측 확인, -p 비대화형
# 모드에서만 자동 스킵됨). 기본 true — 매번 손으로 누르기 귀찮아서 켜둔 것.
# 신뢰 안 하는 디렉토리에서 실수로 자동 승인되는 게 싫으면 false 로.
AUTO_CONFIRM_TRUST=true

# 로그/워치독
LOG_DIR=./logs
WATCHDOG_INTERVAL=60
START_WATCHDOG=true           # bootstrap-v2.sh 실행 시 워치독 v2 자동 백그라운드 기동 여부 (기본 true 권장, config.env 누락 시에도 기본 true 적용)

# Full-Push 이벤트 통지 브리지 설정 (v2 기본 권장, v1은 tmux pull 폴백/레거시)
# BRIDGE_MODE: push (FIFO+asyncRewake 기반 Push 통지 전용, push 고정)
BRIDGE_MODE=push

# WORKER_MODE: oneshot (기본 권장, 작업 단위 단발 실행 어댑터) | resident (상주 TUI 브리지 모드)
# ⚠ Stage 1에서는 agy만 resident 모드를 지원합니다. CODEX_MODE는 반드시 oneshot이어야 합니다.
WORKER_MODE=oneshot
# 개별 워커 모드 오버라이드 (미지정 시 WORKER_MODE 기본값 상속)
# AGY_MODE=resident    # agy 상주 TUI 모드 (Stage 1 지원)
# CODEX_MODE=oneshot  # codex는 oneshot 고정 (Stage 1에서 resident 설정 시 exit 64 fail-closed 거부)


# 워치독 타이머 안전망
DEFAULT_TASK_TIMEOUT=1800     # 작업 기본 타임아웃 (30분)
NO_OUTPUT_WARN_SECONDS=900    # 출력 무변경 스톨 경고 기준 (15분)
EVENT_DELIVERY_GRACE=120      # pending 이벤트 전달 지연 유예 (2분)
EVENT_CLAIM_TIMEOUT=30          # 이벤트 선점(claiming) 타임아웃 (30초, 미완료 시 pending 롤백)
EVENT_ACK_TIMEOUT=600         # 이벤트 확인 응답 타임아웃 (10분, 초과 시 pending 재전달)
EVENT_BATCH_MAX=8             # 1회 알림당 최대 이벤트 묶음 수
EVENT_TAIL_BYTES=1600         # 이벤트 요약 시 로그 꼬리 추출 바이트 수
WATCHDOG_AUTO_KILL=false      # 마감 초과 시 강제 kill 여부 (기본 false: 모델 판단 위임)

# Codex 모델 해석 설정 (adapters/codex-oneshot.sh)
# CODEX_TIER: bin/resolve-model.sh 를 통해 최신 모델 자동 해석 (기본값: sol)
# CODEX_TIER=sol
# CODEX_MODEL: 비상용 수동 오버라이드 (지정 시 resolve-model.sh 우회, 평소에는 비워둠)
# CODEX_MODEL=

# Codex 추론 강도 (reasoning effort) 설정 (adapters/codex-oneshot.sh)
# 사용자 결정: 상위 티어(Sol 등) 모델은 medium 추론 강도를 사용
CODEX_EFFORT=medium

# 세션 재개 시 자동 참조할 프로젝트 인계 파일 경로 (선택 사항, 비워두면 비활성)
# 예: HANDOFF_FILE=docs/RESUME_HANDOFF.md
HANDOFF_FILE=

# 상태 대시보드 (dashboard/, tailnet 전용 읽기 전용 웹 모니터)
# DASHBOARD_STATE_DIR=        # PID/로그 분리 디렉터리 (미지정 시 dashboard/.pid, logs/dashboard.log)
# ACC_DASHBOARD_PID_FILE=     # 대시보드 PID 파일 위치 개별 지정
# ACC_DASHBOARD_LOG_FILE=     # 대시보드 로그 파일 위치 개별 지정
# ACC_TRANSCRIPT_ROOT=        # 트랜스크립트 탐색 루트 디렉터리 (미지정 시 ~/.gemini/antigravity-cli)

