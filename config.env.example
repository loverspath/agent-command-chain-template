# agent-command-chain-template 설정값
# 사용법: cp config.env.example config.env  후 값 수정

# tmux 세션 이름 (다른 프로젝트와 겹치지 않게 프로젝트별로 바꿀 것)
SESSION_NAME=agentchain

# tmux 윈도우 이름
SONNET_WINDOW=sonnet
AGY_WINDOW=agy
CODEX_WINDOW=codex

# Sonnet(계층1: 감독/디스패치) 실행 커맨드
# --remote-control 은 스크립트에서 바로 켜지는 옵션 (첫 실행 시 대화형 확인 없음).
# 단, claude.ai Pro/Max/Team/Enterprise 구독 + `claude /login` OAuth 로그인이
# 사전에 되어 있어야 한다. API 키 인증(ANTHROPIC_API_KEY)만 있으면 안 됨.
SONNET_CMD="claude --model sonnet --remote-control"

# agy(계층2: 라우터 겸 워커) 실행 커맨드 — 대화형 기동.
# 출처: eraweb-fork CLI_START_HERE.md 의 공식 수동 진입 절차.
# 참고: 같은 저장소 tools/router/src/adapters/agyAdapter.ts 의 one-shot 형태는
#   agy --dangerously-skip-permissions -p "<promptfile>"  (작업 하나 던지고 끝내는 방식,
#   지속형 tmux 창엔 안 맞아서 여기선 안 씀)
AGY_CMD="agy --new-project --mode plan"

# Codex Terra(계층2 안의 설계+직접수행 워커) 실행 커맨드.
# 출처: tools/router/src/adapters/codexAdapter.ts 에 실제 하드코딩된 값 그대로.
# `codex exec`는 one-shot이라 작업 하나 끝나면 프로세스가 종료된다 — watchdog.sh가
# 그걸 "죽음"으로 보고 그냥 재기동하므로 사실상 문제없이 맞물린다(우연히 잘 맞는
# 조합, 의도된 설계는 아님). Sol(tier3) 상담이 필요하면 이 값을 그때그때
# --model gpt-5.6-sol 로 바꿔서 send-keys 로 보내면 된다(별도 상시 창 없음).
CODEX_CMD="codex exec --model gpt-5.6-terra -s danger-full-access"

# 로그/워치독
LOG_DIR=./logs
WATCHDOG_INTERVAL=30
